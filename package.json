{
  "name": "local-arcade",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "npm run registry:freshness && vinext build",
    "start": "vinext start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts tests/*.test.tsx && node --test tests/*.test.mjs",
    "discover": "tsx scripts/discover-hugging-face.ts",
    "ingest": "tsx scripts/ingest.ts",
    "registry:discover:hf": "npm run discover",
    "registry:import:hf": "npm run ingest",
    "registry:freshness": "tsx scripts/check-registry-freshness.ts",
    "contracts:validate": "node docs/contracts/validate-fixtures.mjs",
    "research:ranking": "tsc -p research/ranking/tsconfig.json && tsx --test research/ranking/*.test.ts",
    "research:llmfit": "node research/llmfit/validate.mjs && tsx --test research/llmfit/normalization/adapter.test.ts research/llmfit/equivalence/equivalence.test.ts research/llmfit/replay/bridge.test.ts research/llmfit/production-contract/production-contract.test.ts",
    "check:llmfit-adapter": "cargo fmt --manifest-path crates/llmfit-adapter/Cargo.toml --check && cargo clippy --manifest-path crates/llmfit-adapter/Cargo.toml --locked --all-targets -- -D warnings && cargo test --manifest-path crates/llmfit-adapter/Cargo.toml --locked",
    "proof:mb": "npm run research:llmfit && npm run check:llmfit-adapter",
    "proof:mf": "tsx --test research/mf-assessment/assessment-contract.test.ts && node --test research/mf-assessment/boundary.test.mjs",
    "proof:mf-admission": "tsx --test research/mf-profile-admission/admission.test.ts research/mf-profile-admission/record-digest.test.ts && node --test research/mf-profile-admission/boundary.test.mjs",
    "proof:mf-collection-contract": "tsx --test research/mf-profile-collection/collection-contract.test.ts && node --test research/mf-profile-collection/boundary.test.mjs",
    "proof:mf-profile-derivation": "tsx --test research/mf-profile-collection/profile-derivation.test.ts",
    "proof:mf-policy-evaluation": "tsx --test research/mf-profile-collection/policy-sweep.test.ts",
    "proof:mf-production-readiness": "tsx --test research/mf-profile-collection/production-readiness.test.ts",
    "proof:mh": "tsc -p research/mh-portfolio/tsconfig.json && tsx --test research/mh-portfolio/portfolio.test.ts && node --test research/mh-portfolio/boundary.test.mjs",
    "proof:mo": "tsc -p research/mo-orchestration/tsconfig.json && tsx --test research/mo-orchestration/orchestration.test.ts && node --test research/mo-orchestration/boundary.test.mjs",
    "proof:context-policy": "tsc -p research/context-policy/tsconfig.json && tsx --test research/context-policy/*.test.ts && node --test research/context-policy/boundary.test.mjs",
    "proof:mo-runner": "tsc -p research/mo-runner-orchestration/tsconfig.json && tsx --test research/mo-runner-orchestration/runner.test.ts && node --test research/mo-runner-orchestration/boundary.test.mjs",
    "proof:mo-import": "tsc -p research/mo-import-inspection/tsconfig.json && tsx --test research/mo-import-inspection/inspection.test.ts && node --test research/mo-import-inspection/boundary.test.mjs",
    "proof:mo-verification-preview": "tsc -p research/mo-verification-preview/tsconfig.json && tsx --test research/mo-verification-preview/verification-preview.test.ts && node --test research/mo-verification-preview/boundary.test.mjs",
    "proof:mo-checkpoint": "npm run proof:context-policy && npm run proof:mo && npm run proof:mo-runner && npm run proof:mo-import && npm run proof:mo-verification-preview",
    "proof:capabilities": "tsx research/capability-proofs/cli.ts",
    "proof:interfaces": "tsx research/interface-proofs/cli.ts",
    "docs:validate": "node docs/validate-documentation.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "lint": "eslint app lib tests worker public/design-system/constellation.js eslint.config.mjs next.config.ts postcss.config.mjs vite.config.ts"
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.45.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.22.1",
    "typescript": "5.9.3",
    "vinext": "0.2.1",
    "vite": "8.1.5",
    "wrangler": "4.112.0"
  },
  "overrides": {
    "postcss": "8.5.19"
  },
  "type": "module"
}
