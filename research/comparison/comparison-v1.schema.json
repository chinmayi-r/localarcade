{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localarcade.example/research/comparison-v1.schema.json",
  "title": "Local Arcade non-production recommendation comparison v1",
  "type": "object",
  "required": ["schemaVersion", "scenario", "sources", "systemResults"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "scenario": {
      "type": "object",
      "required": ["scenarioId", "hardware", "task", "constraints"],
      "properties": {
        "scenarioId": { "type": "string", "minLength": 1 },
        "hardware": {
          "type": "object",
          "required": ["osFamily", "acceleratorVendor", "acceleratorModel", "acceleratorMemoryBytes", "systemMemoryBytes", "unifiedMemory"],
          "properties": {
            "osFamily": { "enum": ["windows", "macos", "linux", "other"] },
            "acceleratorVendor": { "enum": ["nvidia", "amd", "apple", "intel", "cpu", "other"] },
            "acceleratorModel": { "type": ["string", "null"] },
            "acceleratorMemoryBytes": { "type": ["integer", "null"], "minimum": 1 },
            "systemMemoryBytes": { "type": "integer", "minimum": 1 },
            "unifiedMemory": { "type": ["boolean", "null"] }
          },
          "additionalProperties": false
        },
        "task": {
          "type": "object",
          "required": ["family", "interactionStyle", "contextTokens", "priority"],
          "properties": {
            "family": { "enum": ["coding", "writing", "extraction", "general", "other"] },
            "interactionStyle": { "enum": ["interactive", "batch"] },
            "contextTokens": { "type": "integer", "minimum": 1 },
            "priority": { "enum": ["balanced", "quality", "speed", "long-context", "lightest"] }
          },
          "additionalProperties": false
        },
        "constraints": {
          "type": "object",
          "required": ["maximumArtifactBytes", "allowedBackends", "installedOnly"],
          "properties": {
            "maximumArtifactBytes": { "type": ["integer", "null"], "minimum": 1 },
            "allowedBackends": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["cuda", "rocm", "metal", "vulkan", "cpu", "other"] }
            },
            "installedOnly": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sourceId", "url", "retrievedAt", "sourceClass", "dataUseStatus"],
        "properties": {
          "sourceId": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "retrievedAt": { "type": "string", "format": "date-time" },
          "sourceClass": { "enum": ["upstream-tool", "model-author", "runtime-author", "community-consensus", "community-measurement", "local-measurement", "research-paper"] },
          "dataUseStatus": { "enum": ["reference-only", "redistribution-approved", "unknown"] }
        },
        "additionalProperties": false
      }
    },
    "systemResults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["systemId", "systemVersion", "inputMapping", "mappingNotes", "candidates"],
        "properties": {
          "systemId": { "type": "string", "minLength": 1 },
          "systemVersion": { "type": "string", "minLength": 1 },
          "inputMapping": { "enum": ["exact", "lossy", "unsupported"] },
          "mappingNotes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["rank", "disposition", "modelFamilyId", "artifactId", "runtimeIdentityComplete", "runnable", "evidenceApplicability", "reasons"],
              "properties": {
                "rank": { "type": ["integer", "null"], "minimum": 1 },
                "disposition": { "enum": ["considered", "recommended", "excluded", "unsupported"] },
                "modelFamilyId": { "type": "string", "minLength": 1 },
                "artifactId": { "type": ["string", "null"] },
                "runtimeIdentityComplete": { "type": "boolean" },
                "runnable": { "enum": ["yes", "no", "unknown"] },
                "evidenceApplicability": { "enum": ["exact", "compatible", "proxy", "unknown"] },
                "reasons": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
